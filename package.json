{
  "name": "create-boba-app",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "create-boba-app": "bin/create-boba-app.js"
  },
  "files": [
    "bin",
    "template"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "npm --prefix template run dev",
    "build": "npm --prefix template run build",
    "test": "node --test test/*.test.ts && npm --prefix template test",
    "typecheck": "npm --prefix template run typecheck",
    "lint": "oxlint bin test && prettier --check bin test && npm --prefix template run lint",
    "format": "prettier --write bin test && npm --prefix template run format",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.6"
  }
}
