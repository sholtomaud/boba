{
  "name": "my-boba-app",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/main.ts",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "start": "vite --host",
    "dev": "vite --host",
    "build": "vite build --base ./",
    "preview": "vite preview",
    "boba": "node scripts/boba.ts",
    "test": "node --test \"{src,scripts}/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "lint": "oxlint && prettier --check \"{src,scripts,e2e}/**/*.{ts,js}\"",
    "format": "prettier --write \"{src,scripts,e2e}/**/*.{ts,js}\"",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.6"
  }
}
